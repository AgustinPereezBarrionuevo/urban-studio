
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Acceso administrativo | Urban Studio</title>
  </head>

  <body>
    <main class="login-page">
      <section class="login-card">
        <a class="brand" href="/" aria-label="Volver a Urban Studio">
          URBAN<span>.</span> STUDIO
        </a>

        <p class="eyebrow">PANEL DE ADMINISTRACIÓN</p>
        <h1>Bienvenido de nuevo.</h1>
        <p class="description">
          Ingresá con tu cuenta para administrar Urban Studio.
        </p>

        <form id="login-form">
          <label for="email">Correo electrónico</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="username"
            placeholder="tu@email.com"
            required
          />

          <label for="password">Contraseña</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="Tu contraseña"
            required
          />

          <button id="login-button" type="submit">
            Iniciar sesión
          </button>

          <p id="login-message" role="status" aria-live="polite"></p>
        </form>

        <a class="back-link" href="/">← Volver al sitio web</a>
      </section>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    :global(html),
:global(body) {
  margin: 0;
  min-height: 100%;
  background: #090909;
}
  }

  

  .login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    background:
      radial-gradient(ellipse at top, #292116 0%, transparent 48%),
      #090909;
    color: #f5f5f5;
    font-family: Arial, Helvetica, sans-serif;
  }

  .login-card {
    width: 100%;
    max-width: 440px;
    padding: 40px;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 16px;
    background: #111;
    box-shadow: 0 24px 70px rgb(0 0 0 / 35%);
  }

  .brand {
    color: white;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .brand span {
    color: #fbbf24;
  }

  .eyebrow {
    margin-top: 42px;
    color: #fbbf24;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  h1 {
    margin: 14px 0 10px;
    font-size: clamp(28px, 6vw, 36px);
    letter-spacing: -0.04em;
  }

  .description {
    margin-bottom: 30px;
    color: #a3a3a3;
    line-height: 1.7;
  }

  label {
    display: block;
    margin: 20px 0 8px;
    font-size: 13px;
    font-weight: 600;
  }

  input {
    width: 100%;
    padding: 13px 14px;
    border: 1px solid #383838;
    border-radius: 7px;
    outline: none;
    background: #090909;
    color: white;
    font: inherit;
  }

  input:focus {
    border-color: #fbbf24;
    box-shadow: 0 0 0 2px rgb(251 191 36 / 12%);
  }

  button {
    width: 100%;
    margin-top: 26px;
    padding: 14px;
    border: 0;
    border-radius: 7px;
    background: #fbbf24;
    color: #171717;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
  }

  button:hover {
    background: #fcd34d;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  #login-message {
    min-height: 20px;
    margin-top: 14px;
    color: #fca5a5;
    font-size: 13px;
    line-height: 1.5;
  }

  .back-link {
    display: inline-block;
    margin-top: 12px;
    color: #a3a3a3;
    font-size: 13px;
    text-decoration: none;
  }

  .back-link:hover {
    color: #fbbf24;
  }

  @media (max-width: 480px) {
    .login-card {
      padding: 28px 22px;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const form = document.querySelector('#login-form');
  const emailInput = document.querySelector('#email');
  const passwordInput = document.querySelector('#password');
  const loginButton = document.querySelector('#login-button');
  const message = document.querySelector('#login-message');

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const email = emailInput.value.trim();
    const password = passwordInput.value;

    loginButton.disabled = true;
    loginButton.textContent = 'Verificando...';
    message.textContent = '';

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error || !data.user) {
        message.textContent =
          'No se pudo iniciar sesión. Revisá el correo y la contraseña.';
        return;
      }

      const { data: profile, error: profileError } = await supabase
        .from('profiles')
        .select('full_name, role')
        .eq('id', data.user.id)
        .maybeSingle();

      if (profileError || profile?.role !== 'owner') {
        await supabase.auth.signOut();

        message.textContent =
          'Esta cuenta no tiene permisos de propietario para acceder al panel.';
        return;
      }

      window.location.assign('/admin/');
    } catch (error) {
      console.error('Error durante el inicio de sesión:', error);

      message.textContent =
        'Ocurrió un problema de conexión. Probá nuevamente.';
    } finally {
      loginButton.disabled = false;
      loginButton.textContent = 'Iniciar sesión';
    }
  });
</script>
