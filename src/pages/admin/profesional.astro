
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Perfil profesional | Urban Studio</title>
  </head>

  <body>
    <main class="dashboard">
      <header class="topbar">
        <a href="/" class="brand">URBAN<span>.</span> STUDIO</a>

        <div class="topbar-actions">
          <a href="/admin/" class="nav-link">Volver al panel</a>
          <button id="logout-button" class="secondary-button" type="button">
            Cerrar sesión
          </button>
        </div>
      </header>

      <section class="content">
        <p class="eyebrow">PANEL DE ADMINISTRACIÓN</p>
        <h1>Perfil profesional</h1>
        <p class="description">
          Actualizá el nombre visible, la biografía y la fotografía que aparecen
          en la web de Urban Studio.
        </p>

        <p id="page-message" role="status" aria-live="polite">
          Verificando sesión...
        </p>

        <form id="profile-form" class="settings-form" hidden>
          <section class="settings-section">
            <h2>Foto de perfil</h2>
            <p class="section-description">
              Elegí una fotografía clara y de buena calidad. Se recomienda JPG,
              PNG o WebP de hasta 10 MB.
            </p>

            <div class="profile-preview">
              <img
                id="avatar-preview"
                src="/images/galeria/barbero.jpg"
                alt="Vista previa del perfil profesional"
              />

              <div class="profile-photo-fields">
                <label for="profile-image" class="field-label">
                  Fotografía
                </label>

                <div class="file-picker">
                  <input
                    id="profile-image"
                    class="file-input-hidden"
                    type="file"
                    accept="image/jpeg,image/png,image/webp"
                    aria-describedby="profile-image-help profile-image-name"
                  />

                  <label for="profile-image" class="file-picker-button">
                    <span aria-hidden="true">＋</span>
                    Seleccionar fotografía
                  </label>

                  <span id="profile-image-name" class="file-name">
                    No seleccionaste una nueva fotografía
                  </span>
                </div>

                <p id="profile-image-help" class="field-help">
                  Si no seleccionás otra foto, se conservará la actual.
                </p>
              </div>
            </div>
          </section>

          <section class="settings-section">
            <h2>Información profesional</h2>
            <p class="section-description">
              Estos datos se mostrarán en la sección de profesionales de la web.
            </p>

            <div class="form-grid">
              <div class="field field-full">
                <label for="professional-name">Nombre visible</label>
                <input
                  id="professional-name"
                  type="text"
                  maxlength="100"
                  required
                />
              </div>

              <div class="field field-full">
                <label for="professional-bio">Biografía</label>
                <textarea
                  id="professional-bio"
                  maxlength="1000"
                  rows="5"
                  placeholder="Contá brevemente tu experiencia y tu estilo de trabajo."
                ></textarea>
                <p class="field-help">
                  Si dejás la biografía vacía, la web utilizará su descripción
                  predeterminada.
                </p>
              </div>
            </div>
          </section>

          <div class="form-footer">
            <p id="save-message" role="status" aria-live="polite"></p>
            <button id="save-button" class="primary-button" type="submit">
              Guardar cambios
            </button>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  [hidden] {
    display: none !important;
  }

  :global(html),
  :global(body) {
    margin: 0;
    min-height: 100%;
    background: #0a0a0a;
  }

  .dashboard {
    min-height: 100vh;
    background: #0a0a0a;
    color: #f5f5f5;
    font-family: Arial, Helvetica, sans-serif;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 22px clamp(20px, 5vw, 72px);
    border-bottom: 1px solid #262626;
  }

  .brand {
    color: #fff;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .brand span {
    color: #fbbf24;
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .nav-link {
    color: #d4d4d4;
    font-size: 13px;
    text-decoration: none;
  }

  .nav-link:hover {
    color: #fbbf24;
  }

  .content {
    max-width: 1000px;
    margin: 0 auto;
    padding: 54px 24px 80px;
  }

  .eyebrow {
    color: #fbbf24;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  h1 {
    margin: 14px 0 10px;
    font-size: clamp(32px, 5vw, 46px);
    letter-spacing: -0.04em;
  }

  h2 {
    margin: 0;
    font-size: 21px;
  }

  .description,
  .section-description {
    color: #a3a3a3;
    font-size: 14px;
    line-height: 1.7;
  }

  #page-message,
  #save-message {
    color: #a3a3a3;
    font-size: 13px;
    line-height: 1.6;
  }

  .settings-section {
    margin-top: 30px;
    padding: 26px;
    border: 1px solid #292929;
    border-radius: 12px;
    background: #111;
  }

  .section-description {
    margin: 10px 0 24px;
  }

  .profile-preview {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  #avatar-preview {
    width: 160px;
    height: 190px;
    flex-shrink: 0;
    border: 1px solid #383838;
    border-radius: 10px;
    background: #090909;
    object-fit: cover;
  }

  .profile-photo-fields {
    min-width: 0;
  }

  .field-label,
  .field label {
    display: block;
    margin-bottom: 9px;
    color: #e5e5e5;
    font-size: 13px;
    font-weight: 600;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .field-full {
    grid-column: 1 / -1;
  }

  .field input,
  .field textarea {
    display: block;
    width: 100%;
    min-width: 0;
    padding: 12px;
    border: 1px solid #383838;
    border-radius: 6px;
    background: #090909;
    color: #f5f5f5;
    font: inherit;
    font-size: 14px;
  }

  .field textarea {
    resize: vertical;
    line-height: 1.7;
  }

  .field input:focus,
  .field textarea:focus {
    outline: 1px solid #fbbf24;
    border-color: #fbbf24;
  }

  .field-help {
    margin: 9px 0 0;
    color: #737373;
    font-size: 12px;
    line-height: 1.6;
  }

  .file-picker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 13px;
  }

  .file-input-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .file-picker-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 12px 17px;
    border: 1px solid #5c4a24;
    border-radius: 7px;
    background: #171717;
    color: #f5f5f5;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }

  .file-picker-button:hover {
    background: #242424;
    border-color: #d4a72c;
  }

  .file-picker-button span {
    color: #fbbf24;
    font-size: 18px;
  }

  .file-input-hidden:focus-visible + .file-picker-button {
    outline: 2px solid white;
    outline-offset: 3px;
  }

  .file-name {
    color: #a3a3a3;
    font-size: 13px;
    overflow-wrap: anywhere;
  }

  .form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 26px;
  }

  .primary-button,
  .secondary-button {
    min-height: 43px;
    padding: 12px 17px;
    border-radius: 7px;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }

  .primary-button {
    border: 1px solid #fbbf24;
    background: #fbbf24;
    color: #171717;
  }

  .primary-button:hover:not(:disabled) {
    background: #fcd34d;
    transform: translateY(-1px);
  }

  .secondary-button {
    border: 1px solid #383838;
    background: #141414;
    color: #eee;
  }

  .secondary-button:hover {
    border-color: #fbbf24;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  button:focus-visible,
  a:focus-visible {
    outline: 2px solid #fbbf24;
    outline-offset: 3px;
  }

  @media (max-width: 620px) {
    .topbar {
      align-items: flex-start;
      flex-direction: column;
    }

    .topbar-actions {
      width: 100%;
      justify-content: space-between;
    }

    .content {
      padding: 38px 18px 60px;
    }

    .settings-section {
      padding: 18px;
    }

    .profile-preview {
      align-items: flex-start;
      flex-direction: column;
    }

    #avatar-preview {
      width: 130px;
      height: 155px;
    }

    .form-grid {
      grid-template-columns: 1fr;
    }

    .field-full {
      grid-column: auto;
    }

    .form-footer {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase.js';

  const pageMessage = document.querySelector('#page-message');
  const profileForm = document.querySelector('#profile-form');
  const nameInput = document.querySelector('#professional-name');
  const bioInput = document.querySelector('#professional-bio');
  const imageInput = document.querySelector('#profile-image');
  const imageName = document.querySelector('#profile-image-name');
  const avatarPreview = document.querySelector('#avatar-preview');
  const saveButton = document.querySelector('#save-button');
  const saveMessage = document.querySelector('#save-message');
  const logoutButton = document.querySelector('#logout-button');

  const fallbackImage = '/images/galeria/barbero.jpg';

  let currentUser = null;
  let professional = null;
  let previewObjectUrl = null;

  function showSaveMessage(text, success = false) {
    saveMessage.textContent = text;
    saveMessage.style.color = success ? '#86efac' : '#fca5a5';
  }

  imageInput.addEventListener('change', () => {
    const file = imageInput.files?.[0];

    if (previewObjectUrl) {
      URL.revokeObjectURL(previewObjectUrl);
      previewObjectUrl = null;
    }

    if (!file) {
      imageName.textContent = 'No seleccionaste una nueva fotografía';
      avatarPreview.src = professional?.avatar_url || fallbackImage;
      return;
    }

    const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];

    if (!allowedTypes.includes(file.type)) {
      showSaveMessage('Usá una imagen JPG, PNG o WebP.');
      imageInput.value = '';
      imageName.textContent = 'No seleccionaste una nueva fotografía';
      return;
    }

    if (file.size > 10 * 1024 * 1024) {
      showSaveMessage('La imagen supera el límite de 10 MB.');
      imageInput.value = '';
      imageName.textContent = 'No seleccionaste una nueva fotografía';
      return;
    }

    previewObjectUrl = URL.createObjectURL(file);
    avatarPreview.src = previewObjectUrl;
    imageName.textContent = file.name;
    saveMessage.textContent = '';
  });

  async function checkOwnerSession() {
    const {
      data: { user },
      error: authError,
    } = await supabase.auth.getUser();

    if (authError || !user) {
      window.location.replace('/admin/login');
      return;
    }

    const { data: profile, error: profileError } = await supabase
      .from('profiles')
      .select('full_name, role')
      .eq('id', user.id)
      .maybeSingle();

    if (profileError || profile?.role !== 'owner') {
      await supabase.auth.signOut();
      window.location.replace('/admin/login');
      return;
    }

    const { data, error } = await supabase
      .from('professionals')
      .select('id, profile_id, name, bio, avatar_url')
      .eq('profile_id', user.id)
      .maybeSingle();

    if (error || !data) {
      console.error('No se encontró la ficha profesional:', error);
      pageMessage.textContent =
        'No encontramos una ficha profesional vinculada a esta cuenta.';
      return;
    }

    currentUser = user;
    professional = data;

    nameInput.value = data.name || '';
    bioInput.value = data.bio || '';
    avatarPreview.src = data.avatar_url || fallbackImage;

    pageMessage.textContent = `Sesión iniciada como ${profile.full_name}.`;
    profileForm.hidden = false;
  }

  profileForm.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!currentUser || !professional) {
      showSaveMessage('No se verificó la sesión. Volvé a iniciar sesión.');
      return;
    }

    const name = nameInput.value.trim();
    const bio = bioInput.value.trim();
    const file = imageInput.files?.[0];

    if (!name) {
      showSaveMessage('El nombre visible es obligatorio.');
      nameInput.focus();
      return;
    }

    if (file) {
      const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];

      if (!allowedTypes.includes(file.type)) {
        showSaveMessage('Usá una imagen JPG, PNG o WebP.');
        return;
      }

      if (file.size > 10 * 1024 * 1024) {
        showSaveMessage('La imagen supera el límite de 10 MB.');
        return;
      }
    }

    saveButton.disabled = true;
    saveButton.textContent = file ? 'Subiendo fotografía...' : 'Guardando...';
    saveMessage.textContent = '';

    try {
      let avatarUrl = professional.avatar_url || null;

      if (file) {
        const { data: signedData, error: signatureError } =
          await supabase.functions.invoke('cloudinary-signature', {
            body: { type: 'profile' },
          });

        if (signatureError) {
          let detail = signatureError.message;

          try {
            const response = await signatureError.context?.json();
            if (response?.error) detail = response.error;
          } catch {
            // Conservamos el mensaje original si no hay JSON.
          }

          throw new Error(`No se pudo autorizar la subida: ${detail}`);
        }

        if (
          !signedData?.signature ||
          !signedData?.timestamp ||
          !signedData?.apiKey ||
          !signedData?.cloudName ||
          !signedData?.publicId ||
          !signedData?.folder
        ) {
          throw new Error('La función de Cloudinary devolvió una respuesta incompleta.');
        }

        const uploadData = new FormData();
        uploadData.append('file', file);
        uploadData.append('api_key', signedData.apiKey);
        uploadData.append('timestamp', String(signedData.timestamp));
        uploadData.append('signature', signedData.signature);
        uploadData.append('folder', signedData.folder);
        uploadData.append('public_id', signedData.publicId);

        const response = await fetch(
          `https://api.cloudinary.com/v1_1/${signedData.cloudName}/image/upload`,
          {
            method: 'POST',
            body: uploadData,
          },
        );

        const cloudinaryResult = await response.json();

        if (!response.ok) {
          throw new Error(
            cloudinaryResult?.error?.message ||
              'Cloudinary rechazó la fotografía.',
          );
        }

        avatarUrl = cloudinaryResult.secure_url;

        saveButton.textContent = 'Guardando perfil...';
      }

      const { error: updateError } = await supabase
        .from('professionals')
        .update({
          name,
          bio: bio || null,
          avatar_url: avatarUrl,
        })
        .eq('id', professional.id)
        .eq('profile_id', currentUser.id);

      if (updateError) {
        if (file) {
          throw new Error(
            'La foto se subió a Cloudinary, pero no se pudo guardar el perfil en Supabase. Revisá los permisos antes de volver a subirla.',
          );
        }

        throw updateError;
      }

      professional.name = name;
      professional.bio = bio || null;
      professional.avatar_url = avatarUrl;

      avatarPreview.src = avatarUrl || fallbackImage;
      imageInput.value = '';
      imageName.textContent = 'No seleccionaste una nueva fotografía';

      if (previewObjectUrl) {
        URL.revokeObjectURL(previewObjectUrl);
        previewObjectUrl = null;
      }

      showSaveMessage('Perfil profesional actualizado correctamente.', true);
    } catch (error) {
      console.error('Error al guardar el perfil profesional:', error);

      showSaveMessage(
        error instanceof Error
          ? error.message
          : 'No se pudo guardar el perfil. Probá nuevamente.',
      );
    } finally {
      saveButton.disabled = false;
      saveButton.textContent = 'Guardar cambios';
    }
  });

  logoutButton.addEventListener('click', async () => {
    logoutButton.disabled = true;

    const { error } = await supabase.auth.signOut();

    if (error) {
      pageMessage.textContent = 'No se pudo cerrar la sesión. Probá nuevamente.';
      logoutButton.disabled = false;
      return;
    }

    window.location.replace('/admin/login');
  });

  checkOwnerSession().catch((error) => {
    console.error('Error al verificar el perfil profesional:', error);
    pageMessage.textContent =
      'No se pudo verificar el perfil. Volvé a iniciar sesión.';
  });
</script>
