<script>
  import { supabase } from '../../lib/supabase.js';
  import Sortable from 'sortablejs';
  import { openImageCropper } from '../../lib/imageCropper.js';
  import { getCloudinaryCroppedUrl } from '../../lib/cloudinaryCrop.js';

  const pageMessage = document.querySelector('#page-message');
  const uploadForm = document.querySelector('#upload-form');
  const fileInput = document.querySelector('#image-file');
  const selectedFileName = document.querySelector('#selected-file-name');
  const titleInput = document.querySelector('#image-title');
  const categoryInput = document.querySelector('#image-category');
  const uploadButton = document.querySelector('#upload-button');
  const uploadMessage = document.querySelector('#upload-message');
  const gallerySection = document.querySelector('#gallery-section');
  const galleryMessage = document.querySelector('#gallery-message');
  const galleryList = document.querySelector('#gallery-list');
  const refreshButton = document.querySelector('#refresh-button');
  const logoutButton = document.querySelector('#logout-button');

  let currentUser = null;
  let professionalId = null;
  let gallerySortable = null;
  let selectedCrop = null;


fileInput.addEventListener('change', async () => {
  const file = fileInput.files?.[0];
  selectedCrop = null;

  if (!file) {
    selectedFileName.textContent = 'Ninguna fotografía seleccionada';
    return;
  }

  const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];

  if (!allowedTypes.includes(file.type)) {
    showUploadMessage('Usá una imagen JPG, PNG o WebP.', 'error');
    fileInput.value = '';
    selectedFileName.textContent = 'Ninguna fotografía seleccionada';
    return;
  }

  if (file.size > 10 * 1024 * 1024) {
    showUploadMessage('La imagen supera el límite de 10 MB.', 'error');
    fileInput.value = '';
    selectedFileName.textContent = 'Ninguna fotografía seleccionada';
    return;
  }

  try {
    const crop = await openImageCropper(file, {
      title: 'Ajustar fotografía de la galería',
      aspectRatio: 4 / 5,
      previewWidth: 600,
    });

    if (!crop) {
      fileInput.value = '';
      selectedFileName.textContent = 'Ninguna fotografía seleccionada';
      return;
    }

    selectedCrop = {
      x: crop.x,
      y: crop.y,
      width: crop.width,
      height: crop.height,
    };

    // La previsualización se usa en el editor, no se guarda en Cloudinary.
    if (crop.previewUrl) {
      URL.revokeObjectURL(crop.previewUrl);
    }

    selectedFileName.textContent = `${file.name} — encuadre listo`;
    showUploadMessage(
      'Encuadre confirmado. Ya podés publicar la fotografía.',
      'success',
    );
  } catch (error) {
    console.error('Error al ajustar la fotografía:', error);
    fileInput.value = '';
    selectedFileName.textContent = 'Ninguna fotografía seleccionada';
    showUploadMessage('No se pudo abrir el editor de imágenes.', 'error');
  }
});


  function showUploadMessage(text, type = 'info') {
    uploadMessage.textContent = text;

    if (type === 'success') {
      uploadMessage.style.color = '#86efac';
    } else if (type === 'error') {
      uploadMessage.style.color = '#fca5a5';
    } else {
      uploadMessage.style.color = '#a3a3a3';
    }
  }

  async function checkOwnerSession() {
    const {
      data: { user },
      error: authError,
    } = await supabase.auth.getUser();

    if (authError || !user) {
      window.location.replace('/admin/login');
      return;
    }

    const { data: profile, error: profileError } = await supabase
      .from('profiles')
      .select('full_name, role')
      .eq('id', user.id)
      .maybeSingle();

    if (profileError || profile?.role !== 'owner') {
      await supabase.auth.signOut();
      window.location.replace('/admin/login');
      return;
    }

    const { data: professional, error: professionalError } = await supabase
      .from('professionals')
      .select('id')
      .eq('profile_id', user.id)
      .eq('is_active', true)
      .maybeSingle();

    if (professionalError || !professional) {
      pageMessage.textContent =
        'No encontramos una ficha profesional activa vinculada a tu cuenta.';
      return;
    }

    currentUser = user;
    professionalId = professional.id;

    pageMessage.textContent = `Sesión iniciada como ${profile.full_name}.`;
    uploadForm.hidden = false;
    gallerySection.hidden = false;

    await loadGallery();
  }

  async function loadGallery() {
    galleryMessage.textContent = 'Cargando fotografías...';
    galleryList.replaceChildren();
    refreshButton.disabled = true;

    try {
      const { data, error } = await supabase
        .from('gallery_images')
        .select('id, title, category, image_url, is_active, sort_order,  crop_x, crop_y, crop_width, crop_height')
        .order('sort_order', { ascending: true })
        .limit(200);

      if (error) throw error;

      const images = data ?? [];

      if (images.length === 0) {
        galleryMessage.textContent = 'Todavía no hay fotografías registradas.';
        return;
      }

      for (const image of images) {
        const article = document.createElement('article');
        article.className = 'gallery-card';
        article.dataset.id = image.id;
        article.dataset.sortOrder = String(image.sort_order ?? 0);

        const img = document.createElement('img');
        img.src = getCloudinaryCroppedUrl(image.image_url, image);
        img.alt = image.title || 'Fotografía de Urban Studio';
        img.loading = 'lazy';
        img.decoding = 'async';

        const content = document.createElement('div');
        content.className = 'gallery-card-content';
        const dragHandle = document.createElement('button');

        dragHandle.type = 'button';
        dragHandle.className = 'gallery-drag-handle';
        dragHandle.textContent = '⠿ Arrastrar para ordenar';
        dragHandle.title = 'Arrastrá desde acá para cambiar la posición';
        dragHandle.setAttribute(
        'aria-label',
        `Reordenar fotografía: ${image.title || 'Sin título'}`
        );

        const titleField = document.createElement('label');
        titleField.className = 'gallery-edit-field';
        titleField.textContent = 'Título';

        const editTitle = document.createElement('input');
        editTitle.className = 'gallery-edit-input';
        editTitle.type = 'text';
        editTitle.maxLength = 100;
        editTitle.required = true;
        editTitle.value = image.title || '';
        editTitle.setAttribute('aria-label', 'Título de la fotografía');

        titleField.appendChild(editTitle);

        const categoryField = document.createElement('label');
        categoryField.className = 'gallery-edit-field';
        categoryField.textContent = 'Categoría';

        const editCategory = document.createElement('input');
        editCategory.className = 'gallery-edit-input';
        editCategory.type = 'text';
        editCategory.maxLength = 60;
        editCategory.value = image.category || '';
        editCategory.setAttribute('aria-label', 'Categoría de la fotografía');

        categoryField.appendChild(editCategory);

        const status = document.createElement('span');
        status.className = image.is_active
          ? 'gallery-card-status'
          : 'gallery-card-status is-hidden';
        status.textContent = image.is_active ? 'Publicada' : 'Oculta';

        const actionButton = document.createElement('button');
        actionButton.type = 'button';
        actionButton.className = 'gallery-action';
        actionButton.textContent = image.is_active ? 'Ocultar foto' : 'Publicar foto';

        actionButton.addEventListener('click', async () => {
          actionButton.disabled = true;

          const { error: updateError } = await supabase
            .from('gallery_images')
            .update({ is_active: !image.is_active })
            .eq('id', image.id);

          if (updateError) {
            galleryMessage.textContent =
              `No se pudo actualizar "${image.title}": ${updateError.message}`;
            actionButton.disabled = false;
            return;
          }

          await loadGallery();
          galleryMessage.textContent = image.is_active
            ? 'Fotografía ocultada correctamente.'
            : 'Fotografía publicada correctamente.';
        });

        const deleteButton = document.createElement('button');
            deleteButton.type = 'button';
            deleteButton.className = 'gallery-action gallery-action-danger';
            deleteButton.textContent = 'Eliminar foto';

            deleteButton.addEventListener('click', async () => {
            const confirmed = window.confirm(
                `¿Eliminar "${image.title || 'esta fotografía'}"? ` +
                'Se eliminará el archivo de Cloudinary y su registro de Supabase. ' +
                'Esta acción no se puede deshacer.'
            );

            if (!confirmed) return;

            deleteButton.disabled = true;
            deleteButton.textContent = 'Eliminando...';
            galleryMessage.textContent = 'Eliminando fotografía...';

            try {
                const { data, error } = await supabase.functions.invoke(
                'cloudinary-delete',
                {
                    body: { imageId: image.id },
                }
                );

                if (error) {
                let detail = error.message;

                try {
                    const response = await error.context?.json();
                    if (response?.error) detail = response.error;
                } catch {
                    // Conservamos el mensaje original si no hay JSON.
                }

                throw new Error(detail);
                }

                if (!data?.success) {
                throw new Error(data?.error || 'No se pudo eliminar la fotografía.');
                }

                await loadGallery();
                galleryMessage.textContent = 'Fotografía eliminada correctamente.';
            } catch (error) {
                console.error('Error al eliminar la fotografía:', error);

                const errorMessage =
                error instanceof Error
                    ? error.message
                    : 'No se pudo eliminar la fotografía.';

                // Actualizamos la lista por si la función llegó a ocultarla.
                await loadGallery();
                galleryMessage.textContent = errorMessage;
            } finally {
                deleteButton.disabled = false;
                deleteButton.textContent = 'Eliminar foto';
            }
            });

         const saveButton = document.createElement('button');
        saveButton.type = 'button';
        saveButton.className = 'gallery-action gallery-action-primary';
        saveButton.textContent = 'Guardar cambios';

        saveButton.addEventListener('click', async () => {
        const titleValue = editTitle.value.trim();
        const categoryValue = editCategory.value.trim();

        if (!titleValue) {
            galleryMessage.textContent = 'El título es obligatorio.';
            editTitle.focus();
            return;
        }

        saveButton.disabled = true;
        saveButton.textContent = 'Guardando...';

        try {
            const { error: saveError } = await supabase
            .from('gallery_images')
            .update({
                title: titleValue,
                category: categoryValue || null,
            })
            .eq('id', image.id)
            .eq('professional_id', professionalId);

            if (saveError) {
            throw saveError;
            }

            // Actualizar los datos locales después de guardar correctamente.
            image.title = titleValue;
            image.category = categoryValue || null;

            galleryMessage.textContent =
            'Cambios guardados correctamente.';
        } catch (error) {
            console.error('Error al editar la fotografía:', error);

            galleryMessage.textContent =
            error instanceof Error
                ? `No se pudieron guardar los cambios: ${error.message}`
                : 'No se pudieron guardar los cambios. Intentá nuevamente.';
        } finally {
            saveButton.disabled = false;
            saveButton.textContent = 'Guardar cambios';
        }
        });

        content.append(
        dragHandle,
        titleField,
        categoryField,
        status,
        saveButton,
        actionButton,
        deleteButton,
        );

        article.append(img, content);
        galleryList.appendChild(article);
      }

      galleryMessage.textContent =
        `Se muestran ${images.length} fotografías${images.length === 200 ? ' (máximo inicial de 200)' : ''}.`;


        if (!gallerySortable) {
        gallerySortable = Sortable.create(galleryList, {
            animation: 180,
            handle: '.gallery-drag-handle',
            draggable: '.gallery-card',
            ghostClass: 'gallery-card-ghost',
            chosenClass: 'gallery-card-chosen',

            onEnd: async () => {
            await saveGalleryOrder();
            },
        });
        }

    } catch (error) {
      console.error('Error al cargar la galería:', error);
      galleryMessage.textContent =
        'No se pudo cargar la galería. Revisá la consola para más detalles.';
    } finally {
      refreshButton.disabled = false;
    }
  }

  async function saveGalleryOrder() {
  const cards = Array.from(
    galleryList.querySelectorAll('.gallery-card')
  );

  if (!cards.length || !professionalId) return;

  refreshButton.disabled = true;
  galleryMessage.textContent = 'Guardando nuevo orden...';

  try {
    // Asignamos posiciones únicas, incluso si antes había números repetidos.
    const results = await Promise.all(
      cards.map(async (card, index) => {
        const newOrder = index + 1;

        const { error } = await supabase
          .from('gallery_images')
          .update({ sort_order: newOrder })
          .eq('id', card.dataset.id)
          .eq('professional_id', professionalId);

        if (error) throw error;

        return { card, newOrder };
      })
    );

    for (const item of results) {
      item.card.dataset.sortOrder = String(item.newOrder);
    }

    galleryMessage.textContent = 'Orden guardado correctamente.';
  } catch (error) {
    console.error('Error al guardar el orden:', error);

    galleryMessage.textContent =
      'No se pudo guardar el orden. Recargando las fotografías...';

    await loadGallery();
  } finally {
    refreshButton.disabled = false;
  }
}

  uploadForm.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!currentUser || !professionalId) {
      showUploadMessage('La sesión no está verificada. Volvé a iniciar sesión.', 'error');
      return;
    }

    const file = fileInput.files?.[0];
    const title = titleInput.value.trim();
    const category = categoryInput.value.trim();

    if (!file) {
      showUploadMessage('Seleccioná una fotografía.', 'error');
      return;
    }

    const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];

    if (!allowedTypes.includes(file.type)) {
      showUploadMessage('Usá una imagen JPG, PNG o WebP.', 'error');
      return;
    }

    if (file.size > 10 * 1024 * 1024) {
      showUploadMessage('La imagen supera el límite de 10 MB.', 'error');
      return;
    }

        if (!selectedCrop) {
    showUploadMessage(
        'Seleccioná una fotografía y confirmá su encuadre antes de subirla.',
        'error',
    );
    return;
    }

    uploadButton.disabled = true;
    uploadButton.textContent = 'Subiendo imagen...';
    showUploadMessage('Preparando una subida segura...');

    try {
      const { data: lastImage, error: orderError } = await supabase
        .from('gallery_images')
        .select('sort_order')
        .eq('professional_id', professionalId)
        .order('sort_order', { ascending: false })
        .limit(1)
        .maybeSingle();

      if (orderError) {
        throw new Error(`No se pudo consultar el orden de las fotos: ${orderError.message}`);
      }

      const nextSortOrder = (lastImage?.sort_order ?? 0) + 1;

      const { data: signedData, error: signatureError } =
        await supabase.functions.invoke('cloudinary-signature', {
          body: {},
        });

      if (signatureError) {
        let detail = signatureError.message;

        try {
          const response = await signatureError.context?.json();
          if (response?.error) detail = response.error;
        } catch {
          // Usamos el mensaje original si el error no contiene JSON.
        }

        throw new Error(`No se pudo autorizar la subida: ${detail}`);
      }

      if (
        !signedData?.signature ||
        !signedData?.timestamp ||
        !signedData?.apiKey ||
        !signedData?.cloudName ||
        !signedData?.publicId ||
        !signedData?.folder
      ) {
        throw new Error('La función de Cloudinary devolvió una respuesta incompleta.');
      }

      const uploadData = new FormData();
      uploadData.append('file', file);
      uploadData.append('api_key', signedData.apiKey);
      uploadData.append('timestamp', String(signedData.timestamp));
      uploadData.append('signature', signedData.signature);
      uploadData.append('folder', signedData.folder);
      uploadData.append('public_id', signedData.publicId);

      const response = await fetch(
        `https://api.cloudinary.com/v1_1/${signedData.cloudName}/image/upload`,
        {
          method: 'POST',
          body: uploadData,
        },
      );

      const cloudinaryResult = await response.json();

      if (!response.ok) {
        throw new Error(
          cloudinaryResult?.error?.message || 'Cloudinary rechazó la imagen.',
        );
      }

      const { error: insertError } = await supabase
        .from('gallery_images')
        .insert({
          professional_id: professionalId,
          created_by: currentUser.id,
          image_url: cloudinaryResult.secure_url,
          public_id: cloudinaryResult.public_id,
          title,
          category: category || null,
          is_active: true,
          sort_order: nextSortOrder,
          crop_x: selectedCrop.x,
          crop_y: selectedCrop.y,
          crop_width: selectedCrop.width,
          crop_height: selectedCrop.height,
        });

      if (insertError) {
        throw new Error(
          `La imagen se subió a Cloudinary, pero no se pudo registrar en Supabase. No vuelvas a subirla todavía. Detalle: ${insertError.message}`,
        );
      }

      uploadForm.reset();
      selectedCrop = null;
      selectedFileName.textContent = 'Ninguna fotografía seleccionada';
      showUploadMessage('¡Fotografía subida y publicada correctamente!', 'success');
      await loadGallery();
    } catch (error) {
      console.error('Error al subir la fotografía:', error);

      showUploadMessage(
        error instanceof Error
          ? error.message
          : 'No se pudo subir la fotografía. Probá nuevamente.',
        'error',
      );
    } finally {
      uploadButton.disabled = false;
      uploadButton.textContent = 'Subir y publicar';
    }
  });

  refreshButton.addEventListener('click', loadGallery);



  logoutButton.addEventListener('click', async () => {
    logoutButton.disabled = true;

    const { error } = await supabase.auth.signOut();

    if (error) {
      pageMessage.textContent = 'No se pudo cerrar la sesión. Probá nuevamente.';
      logoutButton.disabled = false;
      return;
    }

    window.location.replace('/admin/login');
  });

  checkOwnerSession().catch((error) => {
    console.error('Error al verificar el propietario:', error);
    pageMessage.textContent = 'No se pudo verificar la sesión. Volvé a iniciar sesión.';
  });
</script>
