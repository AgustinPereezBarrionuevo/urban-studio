<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Administrar galería | Urban Studio</title>
  </head>

  <body>
    <main class="dashboard">
      <header class="topbar">
        <a href="/" class="brand">URBAN<span>.</span> STUDIO</a>
        <div class="topbar-actions">
          <a href="/admin/" class="panel-link">Volver al panel</a>
          <button id="logout-button" class="secondary-button" type="button">
            Cerrar sesión
          </button>
        </div>
      </header>

      <section class="content">
        <p class="eyebrow">PANEL DE ADMINISTRACIÓN</p>
        <h1>Galería de trabajos</h1>
        <p class="description">
          Subí nuevas fotografías y elegí cuáles querés mostrar en la web.
        </p>

        <p id="page-message" role="status" aria-live="polite">
          Verificando sesión...
        </p>

        
        <form id="upload-form" class="upload-panel" hidden>
        <h2>Publicar una fotografía</h2>

        <p class="section-description">
            Formatos permitidos: JPG, PNG y WebP. Tamaño máximo: 10 MB.
        </p>

        <div class="form-grid">
            <div class="field field-full">
            <span class="field-label">Fotografía</span>

            <div class="file-picker">
                <input
                id="image-file"
                class="file-input-hidden"
                type="file"
                accept="image/jpeg,image/png,image/webp"
                aria-describedby="file-help selected-file-name"
                required
                />

                <label for="image-file" class="file-picker-button">
                <span aria-hidden="true">＋</span>
                Seleccionar fotografía
                </label>

                <span id="selected-file-name" class="file-name">
                Ninguna fotografía seleccionada
                </span>
            </div>

            <p id="file-help" class="field-help">
                JPG, PNG o WebP. Tamaño máximo: 10 MB.
            </p>
            </div>

            <div class="field">
            <label for="image-title">Título</label>
            <input
                id="image-title"
                type="text"
                maxlength="100"
                placeholder="Ej. Fade clásico"
                required
            />
            </div>

            <div class="field">
            <label for="image-category">Categoría</label>
            <input
                id="image-category"
                type="text"
                maxlength="60"
                placeholder="Ej. Degradado"
            />
            </div>
        </div>

        <button id="upload-button" class="primary-button" type="submit">
            Subir y publicar
        </button>

        <p
            id="upload-message"
            class="form-message"
            role="status"
            aria-live="polite"
        ></p>
        </form>


        <section id="gallery-section" class="gallery-section" hidden>
          <div class="section-heading">
            <h2>Fotografías registradas</h2>
            <button id="refresh-button" class="secondary-button" type="button">
              Actualizar
            </button>
          </div>

          <p id="gallery-message" class="section-description" role="status" aria-live="polite">
            Cargando fotografías...
          </p>

          <div id="gallery-list" class="gallery-list"></div>
        </section>
      </section>
    </main>
  </body>
</html>

