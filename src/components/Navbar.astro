
---
import { site } from '../config/site';
---

<header class="absolute inset-x-0 top-0 z-10 border-b border-white/10 bg-neutral-950/80">
<nav class="fixed inset-x-0 top-0 z-50 w-full bg-neutral-950 border-b border-white/10">
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
        <a
    href="/"
    class="text-xl font-bold uppercase tracking-[0.18em]"
    >
    URBAN<span class="text-amber-400">.</span>
    <span class="ml-1 text-xs tracking-[0.15em] text-neutral-400">
        STUDIO
    </span>
    </a>

    <div class="hidden items-center gap-8 text-sm text-neutral-300 md:flex">
      <a href="#inicio" class="transition hover:text-amber-400">Inicio</a>
      <a href="#servicios" class="transition hover:text-amber-400">Servicios</a>
      <a href="#nosotros" class="transition hover:text-amber-400">Nosotros</a>
      <a href="#galeria" class="transition hover:text-amber-400">Galería</a>
    </div>

        <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-amber-400 px-4 py-2.5 text-sm font-semibold text-neutral-950 transition hover:bg-amber-300"
        >
        Reservar turno
        </a>
  </div>
  </nav>
</header>
