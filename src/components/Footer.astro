
---
import { site } from '../config/site';
---

<footer class="border-t border-white/10 bg-neutral-950 px-6 py-10 sm:px-10">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">

    <!-- Logo y nombre -->
    <a href="/" class="text-lg font-bold uppercase tracking-[0.18em]">
      URBAN<span class="text-amber-400">.</span>
      <span class="ml-1 text-xs tracking-wider text-neutral-400">STUDIO</span>
    </a>

    <!-- Redes sociales -->
    <div class="flex flex-wrap items-center gap-5">

      <!-- Instagram -->
      <a
        href={site.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Seguir a Urban Studio en Instagram"
        class="inline-flex items-center gap-2 text-sm text-neutral-400 transition hover:text-amber-400"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
        </svg>
        <span>Instagram</span>
      </a>

      <!-- WhatsApp: enlace pendiente del número del negocio -->
                
            <a
            href={`https://wa.me/${site.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Contactar a Urban Studio por WhatsApp"
            class="inline-flex items-center gap-2 text-sm text-neutral-400 transition hover:text-[#25D366]"
            >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="21"
                height="21"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
            >
                <path d="M20.52 3.48A11.82 11.82 0 0 0 12.08 0C5.5 0 .14 5.36.14 11.94c0 2.1.55 4.15 1.6 5.96L.04 24l6.25-1.64a11.9 11.9 0 0 0 5.78 1.48h.01c6.58 0 11.94-5.36 11.94-11.94a11.82 11.82 0 0 0-3.5-8.42ZM12.08 21.8a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.71.97.99-3.62-.24-.37a9.85 9.85 0 0 1-1.52-5.25c0-5.45 4.44-9.89 9.89-9.89a9.8 9.8 0 0 1 6.99 2.9 9.8 9.8 0 0 1 2.9 6.99c0 5.45-4.44 9.89-9.9 9.89Zm5.43-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.09 4.49.71.31 1.26.5 1.69.64.71.23 1.35.2 1.86.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" />
            </svg>
            <span>WhatsApp</span>
            </a>


    </div>

    <!-- Copyright -->
    <p class="text-sm text-neutral-600">
      © {new Date().getFullYear()} {site.name}. Todos los derechos reservados.
    </p>

  </div>
</footer>
